# Environment variables for Freezer Inventory Tracker

# Database Configuration
# By default, the application uses SQLite (no configuration needed)
# For PostgreSQL, set DATABASE_URL:
# DATABASE_URL=postgresql://username:password@host:port/database
# Example: DATABASE_URL=postgresql://freezer_user:mypassword@localhost:5432/freezer_inventory

# UPC Database API Key (optional - for barcode lookup)
# Get your free API key at: https://upcdatabase.org/api
# Free tier includes: 100 lookups/month, 25 searches/month
UPC_API_KEY=your_api_key_here

# Pexels API Key (optional - for product images)
# Get your free API key at: https://www.pexels.com/api/
# Free tier includes: 200 requests/hour, unlimited requests/month
# This enables automatic image fetching for products
PEXELS_API_KEY=your_api_key_here

# JWT Secret Key (change in production)
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-key-change-in-production

# Email / SMTP Configuration (optional – required for email notifications)
#
# Option A – Self-hosted Postfix on the GCP server (recommended):
#   Run deployment/setup-email.sh on the server first, then use:
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Freezer Inventory
#
# Option B – External SMTP relay (Gmail, Outlook, SendGrid, etc.):
#   SMTP_SERVER=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password   (Gmail: requires an App Password)
#   EMAIL_FROM_ADDRESS=you@gmail.com
#   EMAIL_FROM_NAME=Freezer Inventory
